# =============================================================================
# DeepSearch MCP Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Required: API Key
# -----------------------------------------------------------------------------
# Your Google Gemini API key (required)
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Model Configuration (optional - defaults shown)
# -----------------------------------------------------------------------------
# Model for generating search queries
# Options: gemini-2.5-flash, gemini-2.5-flash-thinking
# QUERY_GENERATOR_MODEL=gemini-2.5-flash

# Model for web search with Google grounding
# Options: gemini-2.5-flash-lite-preview-06-17
# WEB_SEARCH_MODEL=gemini-2.5-flash-lite-preview-06-17

# Model for reflection and knowledge gap analysis
# Options: gemini-2.5-flash, gemini-2.5-flash-thinking
# REFLECTION_MODEL=gemini-2.5-flash

# Model for final answer generation
# Options: gemini-2.5-flash, gemini-2.5-pro
# ANSWER_MODEL=gemini-2.5-pro

# -----------------------------------------------------------------------------
# Research Configuration (optional - defaults shown)
# -----------------------------------------------------------------------------
# Default research effort level: low, medium, high
# DEFAULT_EFFORT=medium

# Maximum number of research iterations (1-10)
# MAX_RESEARCH_LOOPS=2

# Number of initial search queries to generate (1-10)
# INITIAL_QUERY_COUNT=3

# -----------------------------------------------------------------------------
# Logging Configuration (optional)
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
